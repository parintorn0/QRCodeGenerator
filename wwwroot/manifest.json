{
  "manifest_version": 3,
  "name": "QRCodeGenerator Extension",
  "description": "Create QR Code to sharing everywhere",
  "version": "4.0.0",
  "icons":{
    "16":"icons/16.png",
    "32":"icons/32.png",
    "48":"icons/48.png",
    "128":"icons/128.png"
  },
  "background": {
    "scripts": ["content/BackgroundWorker.js"],
    "service_worker": "content/BackgroundWorker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "framework/*",
        "content/*"
      ],
      "matches": [ "<all_urls>" ]
    }
  ],
  "permissions": ["tabs", "activeTab"]
}
